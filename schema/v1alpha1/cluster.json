{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proxbase.virtbase.com/schema/v1alpha1/cluster.json",
  "$ref": "#/$defs/Cluster",
  "$defs": {
    "Access": {
      "properties": {
        "apiToken": {
          "type": "boolean",
          "description": "Create API token proxbase@pve!api (default true)"
        },
        "portBase": {
          "type": "integer",
          "description": "Node n gets UI port portBase+n and SSH port portBase+100+n; default: the first free range from 18000 in steps of 1000"
        },
        "bindAddress": {
          "type": "string",
          "description": "Host address the UI/SSH forwards listen on (default 127.0.0.1; 0.0.0.0 in the container image)"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Ceph": {
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "version": {
          "type": "string",
          "enum": [
            "squid",
            "tentacle"
          ]
        },
        "osdDisks": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Data disk devices (vdb"
        },
        "pools": {
          "items": {
            "$ref": "#/$defs/CephPool"
          },
          "type": "array"
        },
        "cephfs": {
          "type": "boolean",
          "description": "CephFS storage for ISOs"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "CephPool": {
      "properties": {
        "name": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "maximum": 7,
          "minimum": 1
        },
        "minSize": {
          "type": "integer",
          "maximum": 7,
          "minimum": 1
        },
        "pgNum": {
          "type": "integer"
        },
        "application": {
          "type": "string",
          "enum": [
            "rbd",
            "cephfs",
            "rgw"
          ]
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Cluster": {
      "properties": {
        "apiVersion": {
          "type": "string",
          "enum": [
            "proxbase.virtbase.com/v1alpha1"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "Cluster"
          ]
        },
        "name": {
          "type": "string",
          "maxLength": 15,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "proxmox": {
          "$ref": "#/$defs/Proxmox"
        },
        "nodes": {
          "$ref": "#/$defs/Nodes"
        },
        "networks": {
          "items": {
            "$ref": "#/$defs/Network"
          },
          "type": "array"
        },
        "storage": {
          "$ref": "#/$defs/Storage"
        },
        "access": {
          "$ref": "#/$defs/Access"
        },
        "templates": {
          "$ref": "#/$defs/Templates",
          "description": "VM and container templates to provide on the nodes"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Disk": {
      "properties": {
        "size": {
          "type": "string",
          "pattern": "^[0-9]+[MGT]$"
        },
        "filesystem": {
          "type": "string",
          "enum": [
            "zfs",
            "ext4",
            "xfs",
            "btrfs"
          ],
          "description": "Root disk only"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Network": {
      "properties": {
        "name": {
          "type": "string"
        },
        "cidr": {
          "type": "string",
          "description": "IPv4 prefix; node n gets .1n. Leave empty for an L2-only network (bridge without node IPs)"
        },
        "bridge": {
          "type": "string"
        },
        "vlanAware": {
          "type": "boolean"
        },
        "vlans": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "VLAN IDs or ranges allowed on a VLAN-aware bridge (default 2-4094)"
        },
        "mtu": {
          "type": "integer"
        },
        "roles": {
          "items": {
            "type": "string",
            "enum": [
              "corosync",
              "ceph-public",
              "ceph-cluster",
              "migration"
            ]
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "NodeSpec": {
      "properties": {
        "cpus": {
          "type": "integer"
        },
        "memory": {
          "type": "string",
          "pattern": "^[0-9]+[MG]$"
        },
        "nested": {
          "type": "boolean"
        },
        "rootDisk": {
          "$ref": "#/$defs/Disk"
        },
        "dataDisks": {
          "items": {
            "$ref": "#/$defs/Disk"
          },
          "type": "array",
          "description": "Extra disks; they appear as vdb"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Nodes": {
      "properties": {
        "count": {
          "type": "integer",
          "maximum": 16,
          "minimum": 1
        },
        "namePattern": {
          "type": "string",
          "description": "Node name; {n} is replaced by the node number"
        },
        "defaults": {
          "$ref": "#/$defs/NodeSpec"
        },
        "overrides": {
          "additionalProperties": {
            "$ref": "#/$defs/NodeSpec"
          },
          "type": "object",
          "description": "Per-node settings keyed by node name"
        },
        "removed": {
          "items": {
            "type": "integer"
          },
          "type": "array",
          "description": "Node numbers removed with proxbase node remove; the others keep their addresses"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Proxmox": {
      "properties": {
        "version": {
          "type": "string"
        },
        "mirror": {
          "type": "string",
          "description": "Base URL holding the ISOs and SHA256SUMS"
        },
        "timezone": {
          "type": "string"
        },
        "keyboard": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "sshKeys": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Extra public keys for root on every node"
        },
        "upgrade": {
          "type": "boolean",
          "description": "Run apt dist-upgrade on every node before clustering"
        },
        "goldenImage": {
          "type": "boolean",
          "description": "Clone nodes from a cached installed base image instead of running the installer"
        },
        "aptCache": {
          "type": "boolean",
          "description": "Download packages that proxbase installs (upgrade and Ceph) once through a cache on the host; default true"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Storage": {
      "properties": {
        "zfs": {
          "items": {
            "$ref": "#/$defs/ZFSPool"
          },
          "type": "array"
        },
        "ceph": {
          "$ref": "#/$defs/Ceph"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Templates": {
      "properties": {
        "vms": {
          "items": {
            "$ref": "#/$defs/VMTemplate"
          },
          "type": "array"
        },
        "containers": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Container templates as named by pveam, e.g. debian-13-standard or ubuntu-24.04-standard (newest version); copied to every node"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "VMTemplate": {
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the template in Proxmox VE"
        },
        "image": {
          "type": "string",
          "description": "A known image (debian-13, debian-12, ubuntu-24.04, ubuntu-22.04) or an https URL of a qcow2 or raw image"
        },
        "checksum": {
          "type": "string",
          "pattern": "^(sha256|sha512):[0-9a-f]+$",
          "description": "sha256:\u003chex\u003e or sha512:\u003chex\u003e of an image given by URL (required for URLs)"
        },
        "vmid": {
          "type": "integer",
          "maximum": 999999999,
          "minimum": 100
        },
        "storage": {
          "type": "string",
          "description": "Storage for the disk (default: the root disk's storage, local-zfs on ZFS)"
        },
        "memory": {
          "type": "integer",
          "description": "MiB (default 1024)"
        },
        "cores": {
          "type": "integer",
          "description": "default 1"
        },
        "diskSize": {
          "type": "string",
          "pattern": "^[0-9]+[MGT]$",
          "description": "Grow the disk to this size (default: the image's size)"
        },
        "perNode": {
          "type": "boolean",
          "description": "A copy on every node (VMID vmid+n-1 on node n), for clones on local storage; default: on the first node only"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ZFSPool": {
      "properties": {
        "name": {
          "type": "string"
        },
        "raid": {
          "type": "string",
          "enum": [
            "single",
            "mirror",
            "raid10",
            "raidz",
            "raidz2",
            "raidz3"
          ]
        },
        "disks": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Data disk devices (vdb"
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
  },
  "title": "Proxbase cluster"
}
