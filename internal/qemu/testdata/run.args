-name
guest=lab-pve1,process=lab-pve1
-nodefaults
-no-user-config
-machine
q35,accel=kvm
-cpu
host
-smp
4
-m
4096
-display
none
-device
VGA,bus=pcie.0,addr=0x1
-drive
if=none,id=root,file=/d/pve1-root.qcow2,format=qcow2,cache=unsafe,discard=unmap
-device
virtio-blk-pci,drive=root,bus=pcie.0,addr=0x2,bootindex=1
-device
qemu-xhci,id=usb,bus=pcie.0,addr=0x3
-netdev
user,id=nat,hostfwd=tcp:127.0.0.1:18101-:22,hostfwd=tcp:127.0.0.1:18001-:8006
-device
virtio-net-pci,netdev=nat,mac=52:54:00:50:01:00,bus=pcie.0,addr=0x4
-netdev
dgram,id=net0,local.type=unix,local.path=/r/pve1-cluster.sock,remote.type=unix,remote.path=/r/sw-cluster.sock
-device
virtio-net-pci,netdev=net0,mac=52:54:00:50:01:01,bus=pcie.0,addr=0x5
-object
rng-random,id=rng,filename=/dev/urandom
-device
virtio-rng-pci,rng=rng,bus=pcie.0,addr=0xe
-drive
if=none,id=data0,file=/d/pve1-data0.qcow2,format=qcow2,cache=unsafe,discard=unmap
-device
virtio-blk-pci,drive=data0,bus=pcie.0,addr=0x10
-qmp
unix:/r/pve1.qmp,server=on,wait=off
-pidfile
/r/pve1.pid
-chardev
file,id=ser0,path=/l/pve1-console.log,append=on
-serial
chardev:ser0
-daemonize
